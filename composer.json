{
    "name": "pollora/nectar",
    "description": "AI-powered development context for Pollora — guidelines, skills, and MCP tools for AI agents.",
    "license": "MIT",
    "authors": [
        {
            "name": "Olivier Gorzalka",
            "email": "olivier@amphibee.fr",
            "role": "Developer"
        }
    ],
    "type": "library",
    "require": {
        "laravel/boost": "^2.0",
        "laravel/mcp": "^1.0",
        "php": "^8.3",
        "pollora/discovery": "^0.1 || ^1.0",
        "pollora/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.3",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "pollora/harness": "^0.1.11"
    },
    "autoload": {
        "psr-4": {
            "Pollora\\Nectar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pollora\\Nectar\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pollora\\Nectar\\NectarServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true,
            "cweagans/composer-patches": true
        },
        "sort-packages": true,
        "audit": {
            "ignore-abandoned": [
                "symplify/rule-doc-generator-contracts"
            ]
        }
    },
    "scripts": {
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ],
        "test:lint": "pint --test",
        "test:types": "phpstan analyse",
        "test:unit": "pest",
        "lint": "pint",
        "refacto": "rector",
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
